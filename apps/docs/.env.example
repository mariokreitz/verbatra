# Copy this file to .env and set your Gemini API key. Do not commit your real key.
#
# verbatra loads .env (and .env.local) from this directory automatically and reads
# the provider key from the environment only - never from verbatra.config.ts.
# Get a free key at https://aistudio.google.com/apikey, then run: pnpm i18n
GEMINI_API_KEY=

# Site key for the Arcjet site that protects the contact form API route
# (app/api/contact/route.ts) against bots, abuse, and excess request volume.
# Get this from https://app.arcjet.com for the site protecting this app.
ARCJET_KEY=

# Resend API key scoped to sending only, used to deliver contact form
# submissions to the site operator. Create a dedicated key for this form at
# https://resend.com/api-keys; do not reuse a general-purpose key.
CONTACT_RESEND_API_KEY=
